# Copy to .env and fill in. Never commit the populated .env.

# ─── Supabase ──────────────────────────────────────────────────────────────
# From https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string from Supabase (Connection Pooling > Transaction mode)
# Used by Drizzle for migrations and the API runtime.
DATABASE_URL=postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ─── API ───────────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=debug

# CORS — comma-separated. In dev, allow the web app.
CORS_ORIGINS=http://localhost:3000

# ─── Ingest webhook ────────────────────────────────────────────────────────
# Shared secret external systems pass in X-Ingest-Secret to POST /api/ingest.
# Generate with: openssl rand -hex 32
INGEST_WEBHOOK_SECRET=

# ─── Cron ──────────────────────────────────────────────────────────────────
# Shared secret your cron service passes in X-Cron-Secret to /api/cron/*.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Anthropic ─────────────────────────────────────────────────────────────
# For voice parsing, observations, chat query. Required from Phase 1.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-4-7. Override to swap models.
ANTHROPIC_MODEL=

# ─── OpenAI (Whisper transcription only) ───────────────────────────────────
# Used for voice capture audio → text. Web Speech API is blocked on many
# networks (DNS filters, VPN, etc.) — Whisper sidesteps Google entirely.
# $0.006/min. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — defaults to whisper-1.
OPENAI_WHISPER_MODEL=

# ─── Google (Phase 1: Calendar; Phase 2: Gmail + Drive) ────────────────────
# Create at https://console.cloud.google.com/apis/credentials.
# Authorized redirect URI must exactly match GOOGLE_OAUTH_REDIRECT_URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Where to send the browser after OAuth completes. Defaults to localhost:3000.
WEB_APP_URL=http://localhost:3000

# ─── Web app ───────────────────────────────────────────────────────────────
# Public env vars (must be NEXT_PUBLIC_* to be readable in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001
